<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bright_bg"
    android:padding="20dp"
    tools:context="com.hanson.android.recipe.SearchFragment">

    <!-- Red Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/red_primary"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4sp"
                android:text="🔍 Find Recipes from Your Ingredients"
                android:textColor="@color/bright_yellow"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enter ingredients from your fridge and discover amazing recipes!"
                android:textColor="#FFB74D"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Input Row -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/input_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_card"
        app:cardBackgroundColor="@color/bright_yellow_card"
        app:cardCornerRadius="15dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/red_primary"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boxStrokeColor="@color/red_primary"
                app:hintTextColor="@color/red_primary"
                app:startIconDrawable="@drawable/ic_ingredient_red"
                app:startIconTint="@color/red_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/typeIngredient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g., chicken, tomatoes, onions"
                    android:textColor="@color/black"
                    android:textColorHint="#99000000"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addIngredient"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:text="➕ Add"
                android:textColor="@color/bright_yellow"
                app:backgroundTint="@color/red_primary"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_add_circle"
                app:iconGravity="textStart"
                app:iconTint="@color/bright_yellow" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Selected Ingredients Grid -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/input_card"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:text="📝 Your Ingredients"
        android:textColor="@color/red_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@+id/buttonSearch"
        android:layout_below="@id/input_card"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/red_primary"
        app:strokeWidth="1dp">

        <GridView
            android:id="@+id/gridSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:columnWidth="100dp"
            android:gravity="center"
            android:horizontalSpacing="12dp"
            android:numColumns="3"
            android:padding="16dp"
            android:stretchMode="spacingWidthUniform"
            android:verticalSpacing="12dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Empty State -->
    <TextView
        android:id="@+id/txt_empty_ingredients"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:lineSpacingExtra="8sp"
        android:text="🍅 No ingredients added yet!\nAdd some ingredients to find recipes"
        android:textAlignment="center"
        android:textColor="@color/dark_red"
        android:textSize="16sp" />

    <!-- Search Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSearch"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:elevation="10dp"
        android:text="🔍 FIND RECIPES NOW"
        android:textColor="@color/bright_yellow"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/red_primary"
        app:cornerRadius="15dp"
        app:icon="@drawable/ic_search_yellow"
        app:iconGravity="textEnd"
        app:iconPadding="12dp"
        app:iconTint="@color/bright_yellow"
        app:rippleColor="@color/bright_red" />

</RelativeLayout>