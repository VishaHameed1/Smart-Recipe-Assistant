<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed/Selected State -->
    <item android:state_pressed="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bright_yellow" />
            <corners android:radius="15dp" />
            <stroke android:width="2dp" android:color="@color/red_primary" />
            <padding android:bottom="4dp" android:left="8dp" android:right="8dp" android:top="4dp" />
        </shape>
    </item>

    <!-- Selected State -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bright_yellow" />
            <corners android:radius="15dp" />
            <stroke android:width="2dp" android:color="@color/red_primary" />
        </shape>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33F44336" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/red_primary" />
        </shape>
    </item>

    <!-- Default/Normal State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/red_primary" />
        </shape>
    </item>
</selector>