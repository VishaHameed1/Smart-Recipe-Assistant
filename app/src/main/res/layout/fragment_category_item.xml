<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_margin="8dp"
    android:background="@color/bright_bg">

    <!-- Image with Red Overlay -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/categoryitem_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/red_primary"
            android:scaleType="centerCrop" />

        <!-- Red Gradient Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/image_gradient_overlay" />

        <!-- Category Text Badge -->
        <TextView
            android:id="@+id/categoryitem_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/red_tag_bg"
            android:elevation="8dp"
            android:letterSpacing="0.02"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="🇮🇳 Indian"
            android:textColor="@color/bright_yellow"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Recipe Count -->
        <TextView
            android:id="@+id/categoryitem_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/yellow_badge_bg"
            android:elevation="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="🍽️ 24 Recipes"
            android:textColor="@color/red_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Favorite Icon -->
    <ImageView
        android:id="@+id/categoryitem_favorite"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/circle_bg_red"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:padding="6dp"
        android:src="@drawable/ic_favorite_border"
        app:tint="@color/bright_yellow" />

</FrameLayout>