<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bright_bg"
    tools:context="com.hanson.android.recipe.AddRecipeActivity">

    <!-- Vibrant Red Gradient AppBar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/red_gradient_toolbar"
        android:elevation="12dp"
        android:theme="@style/ThemeOverlay.Material3.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Create New Recipe"
        app:titleCentered="true"
        app:titleTextAppearance="@style/ToolbarTitleStyle"
        app:titleTextColor="@color/white" />

    <!-- Bright Yellow Card with Red Border -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:cardBackgroundColor="@color/bright_yellow_card"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_navigation_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:strokeColor="@color/dark_red"
        app:strokeWidth="3dp">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/light_yellow_bg" />

    </com.google.android.material.card.MaterialCardView>

    <!-- High Contrast Bottom Footer -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_navigation_footer"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/dark_red"
        app:strokeWidth="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <!-- Multicolor Dot Indicator -->
            <LinearLayout
                android:id="@+id/dots_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imgv_Add_navi1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/red_dot_indicator"
                    android:elevation="4dp" />

                <ImageView
                    android:id="@+id/imgv_Add_navi2"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/yellow_dot_indicator"
                    android:elevation="4dp" />

                <ImageView
                    android:id="@+id/imgv_Add_navi3"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/blue_dot_indicator"
                    android:elevation="4dp" />
            </LinearLayout>

            <!-- Vibrant Red Button with Bold Yellow Text -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_Add_recipeAdd"
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:elevation="10dp"
                android:text="PUBLISH RECIPE"
                android:textAllCaps="true"
                android:textColor="@color/golden_yellow"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/red_primary"
                app:cornerRadius="30dp"
                app:icon="@drawable/ic_publish_bright"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/golden_yellow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:rippleColor="@color/bright_red" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>