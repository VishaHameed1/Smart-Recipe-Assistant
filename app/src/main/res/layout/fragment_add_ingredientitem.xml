<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginVertical="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:background="@color/bright_yellow_card"
    android:elevation="2dp"
    android:paddingEnd="12dp">

    <!-- Bullet Point -->
    <TextView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:text="•"
        android:textColor="@color/red_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Ingredient Text -->
    <TextView
        android:id="@+id/txt_ingredient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/red_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="1 tbsp Olive Oil" />

    <!-- Delete Button -->
    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/circle_bg_red"
        android:contentDescription="Delete Ingredient"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        app:srcCompat="@drawable/ic_delete_red"
        app:tint="@color/bright_yellow" />

</LinearLayout>